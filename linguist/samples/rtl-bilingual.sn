// حالات اتجاهية يجب ألا تغيّر شكل رموز المصدر في محرر SultanC.
عرف القلعة(): عدد {
    دع س: عدد = 2;
    دع ص: عدد = 3;

    لو (س <= ص) {
        أرجع س;
    };

    طابق س مع
    | 2 -> {
        أرجع ص;
    }
    | _ -> {
        أرجع 0;
    };
}

// سجل/نوع متعدد الأسطر: الأقواس تتبع اتجاه السطر، والأسماء الإنجليزية تبقى LTR.
عام نوع عقد_دلالي_بدائي = {
    عدد_الحجج: غير_موقع,
    قد_تفشل: منطقي
};

عرف compare_byte_vectors_lexicographically(أ: عدد): منطقي {
    أرجع helper_name(أ);
}
