import std.io.println;
import std.text.number;

// A point in the plane.
type Point = { x: int, y: int };

type Shape =
    | Square of int
    | Rectangle of Point
;

/// Area of a shape.
def area(shape: Shape): int {
    match shape with
    | Shape.Square(side) -> { return side * side; }
    | Shape.Rectangle({ x: w, y: h }) -> { return w * h; };
}

def scale(value: int, factor: int): int {
    return value * factor;
}

def main(): int {
    let corner: Point = { x: 4, y: 5 };
    let total: int = area(Shape.Rectangle(corner));
    let doubled: int = scale(total, 2);
    println(int_to_text(doubled));
    return 0;
}
