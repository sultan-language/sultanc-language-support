استورد std.io.println;
استورد std.text.number;

// نقطة في المستوى.
نوع نقطة = { س: عدد, ص: عدد };

عرف الأكبر(الأول: عدد, الثاني: عدد): عدد {
    إذا (الأول > الثاني) { أرجع الأول; };
    أرجع الثاني;
}

عرف الرئيسية(): عدد {
    ليكن الأعداد: متجه عدد = [3, 9, 4];
    ليكن النتيجة: عدد = الأكبر(الأعداد[0], الأعداد[1]);
    اطبع_سطر(عدد_إلى_نص(النتيجة));
    أرجع 0;
}
