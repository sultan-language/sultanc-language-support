{
  "Function": {"prefix": "def", "body": ["def ${1:name}(${2:value}: ${3:int}): ${4:int} {", "\t$0", "}"], "description": "Function"},
  "دالة": {"prefix": "عرف", "body": ["عرف ${1:الاسم}(${2:القيمة}: ${3:عدد}): ${4:عدد} {", "\t$0", "}"], "description": "دالة"},
  "Public function": {"prefix": "pubdef", "body": ["public def ${1:name}(${2:value}: ${3:int}): ${4:int} {", "\t$0", "}"], "description": "Public function"},
  "دالة عامة": {"prefix": "عام", "body": ["عام عرف ${1:الاسم}(${2:القيمة}: ${3:عدد}): ${4:عدد} {", "\t$0", "}"], "description": "دالة عامة"},
  "Program entry": {"prefix": "main", "body": ["def main(): int {", "\t$0", "\treturn 0;", "}"], "description": "Program entry point"},
  "نقطة البدء": {"prefix": "الرئيسية", "body": ["عرف الرئيسية(): عدد {", "\t$0", "\tأرجع 0;", "}"], "description": "نقطة بدء البرنامج"},
  "Let": {"prefix": "let", "body": ["let ${1:name}: ${2:int} = ${3:value};"], "description": "Binding"},
  "تعريف متغير": {"prefix": "ليكن", "body": ["ليكن ${1:الاسم}: ${2:عدد} = ${3:القيمة};"], "description": "ربط قيمة"},
  "Mutable": {"prefix": "letmut", "body": ["let ${1:name}: mutable ${2:int} = ${3:value};"], "description": "Mutable binding"},
  "متغير قابل للتعديل": {"prefix": "دعم", "body": ["ليكن ${1:الاسم}: متغير ${2:عدد} = ${3:القيمة};"], "description": "ربط قابل للتعديل"},
  "If": {"prefix": "if", "body": ["if (${1:condition}) {", "\t$0", "};"], "description": "If"},
  "شرط": {"prefix": "إذا", "body": ["إذا (${1:الشرط}) {", "\t$0", "};"], "description": "شرط"},
  "If else": {"prefix": "ifelse", "body": ["if (${1:condition}) {", "\t$2", "} else {", "\t$0", "};"], "description": "If / else"},
  "شرط وإلا": {"prefix": "إذاوإلا", "body": ["إذا (${1:الشرط}) {", "\t$2", "} وإلا {", "\t$0", "};"], "description": "شرط مع وإلا"},
  "While": {"prefix": "while", "body": ["while (${1:condition}) {", "\t$0", "}"], "description": "While loop"},
  "حلقة": {"prefix": "طالما", "body": ["طالما (${1:الشرط}) {", "\t$0", "}"], "description": "حلقة طالما"},
  "Match": {"prefix": "match", "body": ["match ${1:value} with", "| ${2:Pattern} -> { $0 }", "| _ -> { };"], "description": "Match"},
  "مطابقة": {"prefix": "طابق", "body": ["طابق ${1:القيمة} مع", "| ${2:النمط} -> { $0 }", "| _ -> { };"], "description": "مطابقة"},
  "Record": {"prefix": "type", "body": ["type ${1:Name} = { ${2:field}: ${3:int} };"], "description": "Record type"},
  "سجل": {"prefix": "نوع", "body": ["نوع ${1:الاسم} = { ${2:الحقل}: ${3:عدد} };"], "description": "نوع سجل"},
  "Enum": {"prefix": "enum", "body": ["type ${1:Name} =", "\t| ${2:First}", "\t| ${3:Second} of ${4:int}", ";"], "description": "Enum type"},
  "تعداد": {"prefix": "تعداد", "body": ["نوع ${1:الاسم} =", "\t| ${2:الأول}", "\t| ${3:الثاني} بنوع ${4:عدد}", ";"], "description": "نوع تعداد"},
  "Import": {"prefix": "import", "body": ["import ${1:std.io.println};"], "description": "Import"},
  "استيراد": {"prefix": "استورد", "body": ["استورد ${1:std.io.println};"], "description": "استيراد"},
  "For": {"prefix": "for", "body": ["for (let ${1:i}: mutable int = ${2:0}; $1 < ${3:count}; $1 := $1 + 1) {", "\t$0", "}"], "description": "C-style for loop"},
  "حلقة لكل": {"prefix": "لكل", "body": ["لكل (ليكن ${1:ف}: متغير عدد = ${2:0}; $1 < ${3:العدد}; $1 := $1 + 1) {", "\t$0", "}"], "description": "حلقة لكل بأسلوب C"},
  "Else if": {"prefix": "elif", "body": ["if (${1:condition}) {", "\t$2", "} else if (${3:condition}) {", "\t$4", "} else {", "\t$0", "};"], "description": "If / else if / else"},
  "شرط متسلسل": {"prefix": "إذاوإلاإذا", "body": ["إذا (${1:الشرط}) {", "\t$2", "} وإلا إذا (${3:الشرط}) {", "\t$4", "} وإلا {", "\t$0", "};"], "description": "إذا / وإلا إذا / وإلا"},
  "Match option": {"prefix": "matchopt", "body": ["match ${1:value} with", "| option.some(${2:item}) -> { $0 }", "| option.none -> { };"], "description": "Match on an option"},
  "مطابقة اختياري": {"prefix": "طابقاختياري", "body": ["طابق ${1:القيمة} مع", "| اختياري.موجود(${2:العنصر}) -> { $0 }", "| اختياري.لا_شيء -> { };"], "description": "مطابقة قيمة اختيارية"},
  "Match result": {"prefix": "matchres", "body": ["match ${1:value} with", "| result.ok(${2:item}) -> { $0 }", "| result.err(${3:error}) -> { };"], "description": "Match on a result"},
  "مطابقة نتيجة": {"prefix": "طابقنتيجة", "body": ["طابق ${1:القيمة} مع", "| نتيجة.نجح(${2:القيمة}) -> { $0 }", "| نتيجة.خطأ(${3:الخطأ}) -> { };"], "description": "مطابقة نتيجة"},
  "Public record": {"prefix": "pubtype", "body": ["public type ${1:Name} = {", "\t${2:field}: ${3:int}", "};"], "description": "Public record type"},
  "سجل عام": {"prefix": "نوععام", "body": ["عام نوع ${1:الاسم} = {", "\t${2:الحقل}: ${3:عدد}", "};"], "description": "نوع سجل عام"},
  "Print line": {"prefix": "println", "body": ["println(${1:\"text\"});"], "description": "Print a line (import std.io.println)"},
  "اطبع سطرا": {"prefix": "اطبع", "body": ["اطبع_سطر(«${1:نص}»);"], "description": "اطبع سطرا (استورد std.io.println)"},
  "Test file header": {"prefix": "testrun", "body": ["// اختبار: تشغيل", "// خروج: ${1:0}", "", "def main(): int {", "\t$0", "\treturn $1;", "}"], "description": "Compiler test: run and check the exit code"},
  "ترويسة اختبار": {"prefix": "اختبار", "body": ["// اختبار: تشغيل", "// خروج: ${1:0}", "", "عرف الرئيسية(): عدد {", "\t$0", "\tأرجع $1;", "}"], "description": "اختبار مترجم: تشغيل وفحص رمز الخروج"}
}
